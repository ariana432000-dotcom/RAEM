# Copy to .env and fill in. Never commit the real .env.

# ---- running models from the page ----
# Long random string. When set, running a forecast or an AI analysis asks for it
# (Settings page > Access token). Leave empty to let anyone who opens the page run models.
RAEM_RUN_TOKEN=

# Ollama server used by the notebooks' AI analysis. On the same machine: http://localhost:11434.
# From Docker to Ollama on the host: http://host.docker.internal:11434 (docker-compose sets this).
OLLAMA_BASE_URL=http://localhost:11434
# Model selected first on the AI Analysis page (the notebooks were written for qwen2.5:7b).
RAEM_LLM_DEFAULT=qwen2.5:7b

# ---- Hugging Face (deploy_hf.py, and the Space saving its data) ----
# A Write token from huggingface.co/settings/tokens
HF_TOKEN=

# ---- cloud LLMs for AI analysis (optional) ----
# Fill in a key and that provider's models appear on the AI Analysis page. Keys stay on the server; the page never sees them.
# Each run makes about 40 LLM calls, which the provider bills. Set RAEM_RUN_TOKEN when the site is public.
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# Model lists (comma-separated) replace the defaults. Pick models that take a temperature and max_tokens (not reasoning models).
# RAEM_OPENAI_MODELS=gpt-4.1-mini,gpt-4o-mini,gpt-4.1
# RAEM_ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5
# RAEM_GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# RAEM_GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# RAEM_KIMI_MODELS=kimi-k2-turbo-preview,kimi-k2-0905-preview,moonshot-v1-32k
# RAEM_KIMI_BASE_URL=https://api.moonshot.ai/v1     # https://api.moonshot.cn/v1 for a China account
# Any OpenAI-compatible server (OpenRouter, DeepSeek, LM Studio...) through the OpenAI entry:
# RAEM_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---- full refresh (all companies) ----
# Long random string. Needed to call POST /api/refresh. Leave empty to turn refresh off.
RAEM_REFRESH_TOKEN=

# ---- serving ----
# Comma-separated sites allowed to call the API from a browser, e.g. https://raem.example.com.
# Leave empty when the page and the API are served from the same address (the default).
RAEM_CORS_ORIGINS=
# Port the server listens on (most hosts set this for you)
PORT=8000
# Time zone for "today": the run date and the notebooks' TRADE_DATE. Hosts usually run on UTC, which is a day behind
# Bangladesh after 18:00 UTC.
TZ=Asia/Dhaka

# ---- optional ----
# RAEM_DB=backend/storage/raem.db          # run database (SQLite)
# RAEM_NOTEBOOK_TIMEOUT=21600              # seconds one AI analysis may take (6 h)
# RAEM_FORECAST_TIMEOUT=1800               # seconds one forecast may take
# RAEM_CELL_TIMEOUT=7200                   # seconds one notebook cell may take (2 h)
# RAEM_EMBED_DOWNLOAD_TIMEOUT=900          # seconds for the one-time download of chromadb's embedding model (memory without Ollama)
